    {
      "confidence": "illustrative",
      "evidence": "機能と図の読み方を比較するために設定した例示。実業務・実装・観測結果ではない。",
      "id": "application-review",
      "name": "申込の審査",
      "entity_id": "application",
      "initial": "draft",
      "description": "申込の提出から審査結果まで。補正の往復と、審査の終端を区別する。",
      "states": [
        {
          "id": "draft",
          "name": "下書き",
          "description": "提出前。顧客が内容を編集できる。"
        },
        {
          "id": "reviewing",
          "name": "審査中",
          "description": "担当者が内容と書類を確認する。"
        },
        {
          "id": "correction",
          "name": "補正待ち",
          "description": "顧客からの修正・追加書類を待つ。"
        },
        {
          "id": "approved",
          "name": "承認済み",
          "description": "審査は完了。契約の手続きへ進める。",
          "terminal": true
        },
        {
          "id": "rejected",
          "name": "否認",
          "description": "今回の申込の審査を終了する。",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "submit",
          "from": "draft",
          "to": "reviewing",
          "label": "提出する",
          "actor": "顧客",
          "condition": "入力必須項目が揃い、利用条件を確認済み"
        },
        {
          "id": "request-correction",
          "from": "reviewing",
          "to": "correction",
          "label": "補正を依頼",
          "actor": "審査担当者",
          "condition": "修正可能な不足・不備がある"
        },
        {
          "id": "resubmit",
          "from": "correction",
          "to": "reviewing",
          "label": "修正して再提出",
          "actor": "顧客",
          "condition": "指摘された不足項目を補完済み"
        },
        {
          "id": "approve",
          "from": "reviewing",
          "to": "approved",
          "label": "承認する",
          "actor": "審査担当者",
          "condition": "審査条件を満たす"
        },
        {
          "id": "reject",
          "from": "reviewing",
          "to": "rejected",
          "label": "否認する",
          "actor": "審査担当者",
          "condition": "審査条件を満たさず、補正では解消しない"
        }
      ]
    }
  ],
